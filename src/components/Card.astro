---
// The system's only container: a flat, square, hairline-bordered cell of the bento grid.
export interface Props {
	as?: "div" | "article" | "li" | "section";
	interactive?: boolean;
	class?: string;
	[key: string]: unknown;
}
const { as: Element = "div", interactive = false, class: className, ...rest } = Astro.props;
---

<Element class:list={["card", className, { "card--interactive": interactive }]} {...rest}>
	<slot />
</Element>

<style>
	.card {
		position: relative;
		min-width: 0;
		padding: var(--space-6);
		background: var(--color-surface);
		border: var(--border);
		transition: border-color var(--dur-base);
	}
	.card--interactive:hover,
	.card--interactive:focus-within {
		border-color: var(--color-border-strong);
		background: var(--color-surface-raised);
	}
</style>
