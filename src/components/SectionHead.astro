---
// Datasheet section head: "2  EXPERIENCE ··········· more →" in micro caps on a heavy rule.
// The number is the section's real position on the page, like a datasheet chapter.
interface Props {
	n: number;
	title: string;
	id?: string;
	more?: { href: string; label: string };
}
const { n, title, id, more } = Astro.props;
---

<div class="sec-head">
	<h2 id={id} class="label"><span class="n num">{n}</span>{title}</h2>
	{more && <a class="more mono" href={more.href}>{more.label} →</a>}
</div>

<style>
	.sec-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
		padding-top: var(--space-2);
		margin-bottom: var(--space-6);
		border-top: var(--rule);
		scroll-margin-top: var(--space-8);
	}
	h2 {
		color: var(--color-text-strong);
	}
	.n {
		display: inline-block;
		min-width: 2.2em;
		color: var(--color-text-faint);
	}
	.more {
		color: var(--color-text-muted);
		white-space: nowrap;
		font-size: var(--step--2);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
	}
</style>
