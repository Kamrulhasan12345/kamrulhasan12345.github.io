---
import { getPosts } from "@/content.config";
import { profile } from "@/data/resume";

// the name links home; Writing appears once there is something to read
const hasPosts = (await getPosts()).length > 0;
const links = [
	{ href: "/projects/", label: "Projects" },
	...(hasPosts ? [{ href: "/blog/", label: "Writing" }] : []),
	{ href: "/about/", label: "About" },
	{ href: "/resume.pdf", label: "Résumé (PDF)" },
];
const path = Astro.url.pathname;
const Name = path === "/" ? "h1" : "p";
---

<header class="container">
	<a class="logo" href="/" aria-hidden="true" tabindex="-1">
		<!-- the old ">_" pixel mark -->
		<svg viewBox="0 0 16 16" width="44" height="44" shape-rendering="crispEdges">
			<path fill="currentColor" d="M2 4h2v2H2zM4 6h2v2H4zM6 8h2v2H6zM4 10h2v2H4zM2 12h2v2H2zM9 12h5v2H9z"></path>
		</svg>
	</a>
	<div>
		<Name class="name"><a href="/">{profile.name}</a></Name>
		<nav aria-label="Main">
			{
				links.map((l) => (
					<a href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined}>
						{l.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	header {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-block: 3.5rem 2rem;
	}
	.logo {
		color: var(--accent);
	}
	.name {
		margin: 0;
		font-size: 1.6rem;
		font-weight: 700;
		line-height: 1.3;
	}
	.name a {
		color: var(--text);
		text-decoration: none;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
	}
	nav a {
		padding: 0.2rem 0.75rem;
		font-size: 0.85rem;
		color: var(--accent);
		text-decoration: none;
		border-left: 1px dotted var(--text-muted);
	}
	nav a:first-child {
		padding-left: 0;
		border-left: 0;
	}
	nav a:hover,
	nav a[aria-current="page"] {
		text-decoration: underline;
	}
	@media (max-width: 34rem) {
		.logo {
			display: none;
		}
	}
</style>
