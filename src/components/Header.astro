---
import { profile } from "@/data/resume";

const tabs = [
	{ href: "/", label: "Index" },
	{ href: "/projects/", label: "Projects" },
	{ href: "/blog/", label: "Writing" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
// datasheet revision = build month
const rev = new Date().toISOString().slice(0, 7);
---

<header class="container">
	<div class="sheet mono" aria-hidden="true">
		<span>{profile.name}</span>
		<span>Engineer datasheet</span>
		<span class="num">Rev. {rev}</span>
	</div>
	<div class="bar">
		<a class="brand" href="/">kamrul</a>
		<nav aria-label="Main" class="tabs">
			{
				tabs.map((t) => (
					<a href={t.href} aria-current={isCurrent(t.href) ? "page" : undefined}>
						{t.label}
					</a>
				))
			}
			<a href="/resume.pdf">Résumé ↓</a>
		</nav>
	</div>
</header>

<style>
	header {
		padding-top: var(--space-6);
	}
	.sheet {
		display: grid;
		grid-template-columns: 1fr auto auto;
		border: 1px solid var(--color-text-strong);
		font-size: var(--step--2);
		color: var(--color-text-strong);
	}
	.sheet span {
		padding: var(--space-1) var(--space-3);
	}
	.sheet span + span {
		border-left: 1px solid var(--color-text-strong);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-4);
		padding-block: var(--space-6) var(--space-4);
	}
	.brand {
		font-weight: 600;
		text-decoration: none;
		color: var(--color-text-strong);
	}
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}
	.tabs a {
		padding: var(--space-1) var(--space-3);
		font-size: var(--step--1);
		text-decoration: none;
		color: var(--color-text-muted);
		border: var(--border-strong);
		transition:
			color var(--dur-fast),
			border-color var(--dur-fast);
	}
	.tabs a:hover {
		color: var(--color-text-strong);
		border-color: var(--color-text-strong);
	}
	.tabs a[aria-current="page"] {
		background: var(--color-text-strong);
		border-color: var(--color-text-strong);
		color: var(--color-bg);
	}
	@media (max-width: 36rem) {
		.sheet {
			grid-template-columns: 1fr auto;
		}
		.sheet span:nth-child(2) {
			display: none;
		}
	}
</style>
