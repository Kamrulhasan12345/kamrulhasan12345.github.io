---
const links = [
	{ href: "/#about", label: "About" },
	{ href: "/#experience", label: "Experience" },
	{ href: "/#research", label: "Publications" },
	{ href: "/projects/", label: "Projects" },
	{ href: "/#skills", label: "Skills" },
	{ href: "/blog/", label: "Writing" },
	{ href: "/#contact", label: "Contact" },
];
const path = Astro.url.pathname;
---

<header class="container">
	<a class="logo" href="/" aria-label="Home">
		<span class="prompt">&gt;</span>MKH<span class="cursor" aria-hidden="true">_</span>
	</a>
	<nav aria-label="Main">
		{
			links.map((l) => (
				<a href={l.href} aria-current={!l.href.includes("#") && path.startsWith(l.href) ? "page" : undefined}>
					{l.label}
				</a>
			))
		}
		<a class="cv" href="/resume.pdf">Resume ↓</a>
	</nav>
</header>

<style>
	header {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-4) var(--space-8);
		padding-block: var(--space-6);
		border-bottom: var(--border);
	}
	.logo {
		font-family: var(--font-pixel);
		font-size: var(--step-1);
		color: var(--color-text-strong);
		text-decoration: none;
	}
	.prompt {
		color: var(--color-accent);
		margin-right: var(--space-2);
	}
	.cursor {
		color: var(--color-accent);
		animation: blink 1.1s steps(1, end) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-6);
	}
	nav a {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--color-text-muted);
	}
	nav a:hover,
	nav a[aria-current="page"] {
		color: var(--color-accent);
		text-decoration: none;
	}
	nav a[aria-current="page"]::before {
		content: "[";
	}
	nav a[aria-current="page"]::after {
		content: "]";
	}
	.cv {
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-accent-dim);
		color: var(--color-accent);
	}
	.cv:hover {
		box-shadow: var(--shadow-px-1);
	}
</style>
