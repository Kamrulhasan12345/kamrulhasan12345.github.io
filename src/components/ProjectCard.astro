---
import Card from "@/components/Card.astro";
import PixelIcon from "@/components/PixelIcon.astro";
import Tag from "@/components/Tag.astro";
import { categoryStyle } from "@/data/categories";
import type { Project } from "@/data/resume";

interface Props {
	project: Project;
	detailed?: boolean;
}
const { project: p, detailed = false } = Astro.props;
const lead = categoryStyle[p.categories[0]];
const stack = detailed ? p.stack : p.stack.slice(0, 4);
// text the /projects search box matches against
const haystack = [p.name, p.title, p.summary, p.context, ...p.points, ...p.stack].join(" ").toLowerCase();
---

<Card as="li" interactive>
	<article class="proj" data-project data-categories={p.categories.join("|")} data-search={haystack}>
		<div class="head">
			<span class="glyph" style={`color: ${lead.color}`}><PixelIcon glyph={lead.glyph} /></span>
			<div class="cluster">
				{p.categories.map((c) => <Tag color={categoryStyle[c].color}>{categoryStyle[c].short}</Tag>)}
				{p.status && <Tag>{p.status}</Tag>}
			</div>
		</div>
		<h3>{p.link ? <a href={p.link}>{p.name}</a> : p.name}</h3>
		<p class="title">{p.title}</p>
		<p class="summary muted">{p.summary}</p>
		{
			detailed && p.points.length > 0 && (
				<ul class="points">
					{p.points.map((pt) => (
						<li>{pt}</li>
					))}
				</ul>
			)
		}
		<dl class="spec mono">
			<dt>Year</dt>
			<dd class="num">{p.year}</dd>
			{
				p.context && (
					<>
						<dt>Context</dt>
						<dd>{p.context}</dd>
					</>
				)
			}
			<dt>Stack</dt>
			<dd>{stack.join(" · ")}{!detailed && p.stack.length > stack.length && ` +${p.stack.length - stack.length}`}</dd>
			<dt>Source</dt>
			<dd>{p.link ? <a href={p.link}>GitHub ↗</a> : <span class="muted">not public yet</span>}</dd>
		</dl>
	</article>
</Card>

<style>
	.proj {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		height: 100%;
	}
	.head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--space-4);
	}
	.head .cluster {
		justify-content: flex-end;
	}
	h3 {
		font-family: var(--font-pixel);
		font-weight: 400;
		font-size: var(--step-1);
		letter-spacing: var(--tracking-pixel);
	}
	h3 a {
		text-decoration: none;
	}
	h3 a:hover {
		text-decoration: underline;
	}
	.title {
		color: var(--color-text-strong);
	}
	.points {
		margin: 0;
		padding-left: var(--space-4);
		color: var(--color-text-muted);
		font-size: var(--step--1);
	}
	.points li + li {
		margin-top: var(--space-2);
	}
	.points li::marker {
		content: "– ";
		color: var(--color-text-faint);
	}
	.spec {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		margin: auto 0 0;
		padding-top: var(--space-3);
		border-top: var(--border);
		font-size: var(--step--1);
	}
	.spec dt,
	.spec dd {
		margin: 0;
		padding-block: var(--space-1);
	}
	.spec dt {
		color: var(--color-text-faint);
	}
	.spec dd {
		color: var(--color-text);
		min-width: 0;
	}
</style>
