---
import type { CollectionEntry } from "astro:content";

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, year, stack, badge } = project.data;
---

<article class="card pxbox">
	<a class="title-link" href={`/projects/${project.id}/`}>
		<h3 class="title">{title}</h3>
	</a>
	<div class="head-meta">
		{badge && <span class="badge">{badge}</span>}
		<span class="year meta">{year}</span>
	</div>
	<p class="summary">{summary}</p>
	<div class="stack">
		{stack.map((item) => <span class="tag">{item}</span>)}
	</div>
</article>

<style>
	.card {
		padding: 1.25rem 1.4rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		transition:
			border-color 160ms ease,
			transform 160ms ease,
			box-shadow 160ms ease;
	}
	.card:hover {
		border-color: var(--accent-muted);
		transform: translate(-3px, -3px);
		box-shadow: 5px 5px 0 var(--px-shadow);
	}
	.title-link {
		text-decoration: none;
		order: -1;
	}
	.title-link:hover {
		text-decoration: none;
	}
	.title {
		margin: 0;
		font-family: var(--font-pixel);
		font-weight: 400;
		font-size: 0.92rem;
		line-height: 1.45;
		letter-spacing: 0.02em;
		color: var(--heading);
	}
	.title-link:hover .title {
		color: var(--accent);
		text-shadow: 0 0 14px var(--glow);
	}
	.head-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: -0.2rem;
	}
	.badge {
		font-family: var(--font-pixel);
		font-size: 0.6rem;
		letter-spacing: 0.08em;
		color: var(--amber);
		border: 1px solid var(--amber-muted);
		padding: 0.15rem 0.55rem;
	}
	.summary {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--text-dim);
		flex-grow: 1;
		line-height: 1.6;
	}
	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.4rem;
	}
</style>
