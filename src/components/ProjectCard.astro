---
import PixelCard from "@/components/PixelCard.astro";
import Tag from "@/components/Tag.astro";
import type { Project } from "@/data/resume";

interface Props {
	project: Project;
	detailed?: boolean;
}
const { project: p, detailed = false } = Astro.props;
// text the /projects search box matches against
const haystack = [p.name, p.title, p.summary, p.context, ...p.points, ...p.stack].join(" ").toLowerCase();
---

<PixelCard as="li" interactive>
	<div class="card" data-project data-categories={p.categories.join("|")} data-search={haystack}>
		<div class="head">
			<span class="label">{p.categories.join(" · ")}</span>
			<span class="mono muted">{p.year}</span>
		</div>
		<h3>
			{p.link ? <a href={p.link}>{p.name}</a> : p.name}
			{p.status && <Tag tone="highlight">{p.status}</Tag>}
		</h3>
		<p class="title">{p.title}</p>
		<p class="summary">{p.summary}</p>
		{
			detailed && p.points.length > 0 && (
				<ul class="points">
					{p.points.map((pt) => (
						<li>{pt}</li>
					))}
				</ul>
			)
		}
		<div class="cluster tags">
			{p.context && <Tag tone="highlight">{p.context}</Tag>}
			{p.stack.map((s) => <Tag>{s}</Tag>)}
		</div>
		<p class="foot mono">
			{p.link ? <a href={p.link}>Source code ↗</a> : <span class="muted">Source not public yet</span>}
		</p>
	</div>
</PixelCard>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		height: 100%;
	}
	.head {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
	}
	h3 {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
		font-family: var(--font-pixel);
		font-weight: 400;
		font-size: var(--step-1);
		letter-spacing: var(--tracking-pixel);
	}
	h3 a {
		color: var(--color-text-strong);
	}
	h3 a:hover {
		color: var(--color-accent);
	}
	.title {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--color-accent);
	}
	.summary {
		color: var(--color-text);
	}
	.points {
		margin: 0;
		padding-left: var(--space-4);
		font-size: 0.95rem;
		color: var(--color-text-muted);
	}
	.points li + li {
		margin-top: var(--space-2);
	}
	.points li::marker {
		content: "› ";
		color: var(--color-accent-dim);
	}
	.tags {
		margin-top: var(--space-1);
	}
	.foot {
		margin-top: auto;
		padding-top: var(--space-3);
		border-top: 1px dashed var(--color-border);
	}
</style>
