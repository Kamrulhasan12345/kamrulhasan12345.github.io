---
interface Props {
	href: string;
	variant?: "primary" | "ghost";
}
const { href, variant = "primary" } = Astro.props;
---

<a class:list={["btn", `btn--${variant}`]} href={href}><slot /></a>

<style>
	.btn {
		display: inline-block;
		padding: var(--space-3) var(--space-6);
		font-family: var(--font-pixel);
		font-size: var(--step--1);
		letter-spacing: var(--tracking-pixel);
		text-transform: uppercase;
		text-decoration: none;
		transition:
			transform var(--dur-fast) var(--ease-step),
			box-shadow var(--dur-fast) var(--ease-step);
	}
	.btn:hover {
		text-decoration: none;
		transform: translate(-2px, -2px);
	}
	.btn:active {
		transform: translate(var(--px), var(--px));
		box-shadow: none;
	}
	.btn--primary {
		background: var(--color-accent);
		color: var(--color-on-accent);
		box-shadow: var(--shadow-px-1);
	}
	.btn--primary:hover {
		background: var(--color-accent-strong);
		color: var(--color-on-accent);
		box-shadow: var(--shadow-px-2);
	}
	.btn--ghost {
		color: var(--color-text-strong);
		border: var(--border-strong);
	}
	.btn--ghost:hover {
		color: var(--color-accent);
		border-color: var(--color-accent-dim);
		box-shadow: var(--shadow-px-1);
	}
</style>
