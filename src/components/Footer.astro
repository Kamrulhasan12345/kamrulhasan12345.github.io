---
import { getPosts } from "@/content.config";
import { profile } from "@/data/resume";
const hasPosts = (await getPosts()).length > 0;
const year = new Date().getFullYear();
---

<footer class="container muted small">
	<span>© {year} {profile.name}</span>
	<span>
		<a href={`mailto:${profile.email}`}>{profile.email}</a> · <a href={profile.github}>GitHub</a> ·
		<a href={profile.linkedin}>LinkedIn</a> · <a href={profile.orcid}>ORCID</a>{hasPosts && <> · <a href="/rss.xml">RSS</a></>}
	</span>
</footer>

<style>
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-top: auto;
		padding-block: 2rem 3rem;
	}
</style>
