---
import Icon from "@/components/Icon.astro";
import { getPosts } from "@/content.config";
import { profile } from "@/data/resume";
const hasPosts = (await getPosts()).length > 0;
const year = new Date().getFullYear();
---

<footer class="container muted small">
	<span>© {year} {profile.name}</span>
	<span class="social">
		<a href={`mailto:${profile.email}`}>{profile.email}</a>
		<a href={profile.github} aria-label="GitHub" title="GitHub"><Icon name="github" /></a>
		<a href={profile.linkedin} aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a>
		<a href={profile.orcid} aria-label="ORCID" title="ORCID"><Icon name="orcid" /></a>
		{hasPosts && <a href="/rss.xml" aria-label="RSS feed" title="RSS feed"><Icon name="rss" /></a>}
	</span>
</footer>

<style>
	.social {
		display: inline-flex;
		align-items: center;
		gap: 0.75em;
	}
	footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-top: auto;
		padding-block: 2rem 3rem;
	}
</style>
