---
// Neutral by default; pass `color` (a category color) only when the tag *is* a category.
interface Props {
	color?: string;
}
const { color } = Astro.props;
---

<span class:list={["tag", { "tag--cat": color }]} style={color ? `--tag: ${color}` : undefined}><slot /></span>

<style>
	.tag {
		display: inline-block;
		padding: 0 var(--space-2);
		font-size: var(--step--2);
		line-height: 1.9;
		letter-spacing: 0.04em;
		white-space: nowrap;
		color: var(--color-text-muted);
		border: var(--border);
	}
	.tag--cat {
		color: var(--tag);
		border-color: color-mix(in oklab, var(--tag) 45%, transparent);
		text-transform: uppercase;
		letter-spacing: var(--tracking-label);
	}
</style>
