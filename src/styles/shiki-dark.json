{
	"name": "datasheet-dark",
	"type": "dark",
	"colors": {
		"editor.background": "#090b10",
		"editor.foreground": "#c9ced9"
	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6b7387",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control"
			],
			"settings": {
				"foreground": "#fba8a0"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#82d79a"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other",
				"keyword.other.unit"
			],
			"settings": {
				"foreground": "#e8b86b"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#ccb1fe"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#6cd2e9"
			}
		},
		{
			"scope": [
				"variable",
				"variable.parameter",
				"variable.other"
			],
			"settings": {
				"foreground": "#c9ced9"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation"
			],
			"settings": {
				"foreground": "#9aa2b4"
			}
		},
		{
			"scope": [
				"meta.preprocessor",
				"keyword.control.directive",
				"punctuation.definition.directive",
				"entity.name.function.preprocessor"
			],
			"settings": {
				"foreground": "#e8b86b"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#fba8a0"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#6cd2e9"
			}
		},
		{
			"scope": [
				"support.constant",
				"variable.language.register",
				"constant.other.register"
			],
			"settings": {
				"foreground": "#e8b86b"
			}
		},
		{
			"scope": [
				"markup.heading"
			],
			"settings": {
				"foreground": "#ccb1fe",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#e07a6a"
			}
		}
	]
}
