{
	"name": "calm-dark",
	"type": "dark",
	"colors": {
		"editor.background": "#1b1f24",
		"editor.foreground": "#ced3d9"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#6b727a", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#c8a6d6" }
		},
		{
			"scope": ["string", "punctuation.definition.string"],
			"settings": { "foreground": "#a3c79b" }
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other",
				"keyword.other.unit"
			],
			"settings": { "foreground": "#e0b775" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": { "foreground": "#8ab4d8" }
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class",
				"entity.other.inherited-class"
			],
			"settings": { "foreground": "#83b8c9" }
		},
		{
			"scope": ["variable", "variable.parameter", "variable.other"],
			"settings": { "foreground": "#ced3d9" }
		},
		{
			"scope": ["keyword.operator", "punctuation"],
			"settings": { "foreground": "#949ba3" }
		},
		{
			"scope": [
				"meta.preprocessor",
				"keyword.control.directive",
				"punctuation.definition.directive",
				"entity.name.function.preprocessor"
			],
			"settings": { "foreground": "#e0b775" }
		},
		{
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#c8a6d6" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#8ab4d8" }
		},
		{
			"scope": ["support.constant", "variable.language.register", "constant.other.register"],
			"settings": { "foreground": "#e0b775" }
		},
		{
			"scope": ["markup.heading"],
			"settings": { "foreground": "#8ab4d8", "fontStyle": "bold" }
		},
		{ "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
		{ "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#e07a6a" }
		}
	]
}
