---
import "@/styles/tokens.css";
import "@/styles/base.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { getPosts } from "@/content.config";
import { profile } from "@/data/resume";

interface Props {
	title?: string;
	description?: string;
	ogType?: "website" | "article";
}

const { title, description = `${profile.name}, ${profile.role}. ${profile.intro}`, ogType = "website" } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const url = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const hasPosts = (await getPosts()).length > 0;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b0f12" media="(prefers-color-scheme: dark)" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		{hasPosts && <link rel="alternate" type="application/rss+xml" title={profile.name} href="/rss.xml" />}
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: 1rem;
		top: -3rem;
		z-index: 10;
		padding: 0.3rem 0.8rem;
		background: var(--accent);
		color: var(--bg);
	}
	.skip:focus {
		top: 1rem;
	}
	main {
		padding-bottom: 4rem;
	}
</style>
