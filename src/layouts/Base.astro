---
import "@/styles/tokens.css";
import "@/styles/base.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { profile } from "@/data/resume";

interface Props {
	title?: string;
	description?: string;
}

const { title, description = `${profile.name}, ${profile.role}. ${profile.intro}` } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : profile.name;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0b0f12" media="(prefers-color-scheme: dark)" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={profile.name} href="/rss.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: 1rem;
		top: -3rem;
		z-index: 10;
		padding: 0.3rem 0.8rem;
		background: var(--accent);
		color: var(--bg);
	}
	.skip:focus {
		top: 1rem;
	}
	main {
		padding-bottom: 4rem;
	}
</style>
