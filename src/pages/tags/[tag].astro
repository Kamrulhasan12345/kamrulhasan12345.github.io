---
import PostPreview from "@/components/PostPreview.astro";
import { getAllTags, getPublishedPosts } from "@/data/collections";
import Base from "@/layouts/Base.astro";

export async function getStaticPaths() {
	const tags = await getAllTags();
	const posts = await getPublishedPosts();
	return tags.map(({ tag }) => ({
		params: { tag },
		props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`Tag: ${tag}`} description={`Posts tagged [${tag}].`}>
	<div class="container">
		<h1>[{tag}]</h1>
		<p class="cmd">grep -rl "{tag}" ~/blog</p>
		<div class="posts">
			{posts.map((post) => <PostPreview post={post} />)}
		</div>
		<p class="back"><a href="/tags/">← all tags</a></p>
	</div>
</Base>

<style>
	.container {
		padding-block: 2.5rem;
	}
	.posts {
		border-top: 1px dashed var(--c-line);
	}
	.back {
		margin-top: 2rem;
		font-size: var(--text-sm);
	}
</style>
