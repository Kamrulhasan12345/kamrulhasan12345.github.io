---
import { getAllTags } from "@/data/collections";
import Base from "@/layouts/Base.astro";

const tags = await getAllTags();
---

<Base title="Tags" description="All blog post tags.">
	<div class="container">
		<h1>Tags</h1>
		<ul>
			{
				tags.map(({ tag, count }) => (
					<li>
						<a href={`/tags/${tag}/`}>{tag}</a>
						<span class="count meta">
							{count} post{count === 1 ? "" : "s"}
						</span>
					</li>
				))
			}
			{tags.length === 0 && <p class="empty">No tags yet.</p>}
		</ul>
	</div>
</Base>

<style>
	.container {
		padding-block: 3rem;
	}
	ul {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		max-width: 26rem;
	}
	li {
		padding: 0.6rem 0;
		border-bottom: 1px solid var(--line-soft);
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	li a {
		font-weight: 500;
	}
	.empty {
		color: var(--text-dim);
	}
</style>
