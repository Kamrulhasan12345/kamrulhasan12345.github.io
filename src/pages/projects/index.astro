---
import ProjectCard from "@/components/ProjectCard.astro";
import { getAllProjects } from "@/data/collections";
import Base from "@/layouts/Base.astro";

const projects = await getAllProjects();
---

<Base title="Projects" description="A decade of builds: systems, security, backends, ML, games, and hardware.">
	<div class="container container--wide">
		<header class="page-head">
			<h1>Projects</h1>
			<p class="sub">
				A decade of builds across systems, security, backends, ML, games, and
				hardware. {projects.length} in the archive.
			</p>
		</header>
		<div class="grid">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>
	</div>
</Base>

<style>
	.container {
		padding-block: 3rem;
	}
	.page-head {
		max-width: 42rem;
		margin-bottom: 2.5rem;
	}
	.sub {
		color: var(--text-dim);
		margin-top: 0.5rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1rem;
	}
</style>
