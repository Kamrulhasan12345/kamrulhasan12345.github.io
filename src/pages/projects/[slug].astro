---
import { render } from "astro:content";
import { getAllProjects } from "@/data/collections";
import Base from "@/layouts/Base.astro";

export async function getStaticPaths() {
	const projects = await getAllProjects();
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { title, summary, role, stack, links } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary}>
	<div class="container">
		<article>
			<header>
				<p class="cmd">cat ~/projects/{project.id}.md</p>
				<h1>{title}</h1>
				<p class="summary">{summary}</p>
				<dl class="facts">
					<dt>role</dt>
					<dd>{role}</dd>
					<dt>stack</dt>
					<dd class="stack">
						{stack.map((item) => <span class="chip">{item}</span>)}
					</dd>
					{
						(links.repo || links.live || links.writeup) && (
							<>
								<dt>links</dt>
								<dd class="links">
									{links.repo && <a href={links.repo}>repo ↗</a>}
									{links.live && <a href={links.live}>live ↗</a>}
									{links.writeup && <a href={links.writeup}>writeup</a>}
								</dd>
							</>
						)
					}
				</dl>
			</header>
			<div class="prose">
				<Content />
			</div>
			<p class="back"><a href="/projects/">← all projects</a></p>
		</article>
	</div>
</Base>

<style>
	.container {
		padding-block: 2.5rem;
	}
	.summary {
		color: var(--c-dim);
		margin-top: 0.25rem;
	}
	.facts {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.35rem 1.5rem;
		margin: 1.5rem 0 2.5rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--c-line);
		background: var(--c-bg-raise);
		font-size: var(--text-sm);
	}
	dt {
		color: var(--c-dim);
	}
	dt::after {
		content: ":";
	}
	dd {
		margin: 0;
	}
	.stack,
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.9rem;
	}
	.back {
		margin-top: 3rem;
		font-size: var(--text-sm);
	}
</style>
