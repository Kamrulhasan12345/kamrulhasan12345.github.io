---
import { render } from "astro:content";
import { getAllProjects } from "@/data/collections";
import Base from "@/layouts/Base.astro";

export async function getStaticPaths() {
	const projects = await getAllProjects();
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { title, summary, year, category, stack, badge, links } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary}>
	<div class="container">
		<article>
			<header>
				<a class="back" href="/projects/">← All projects</a>
				<h1>{title}</h1>
				<p class="summary">{summary}</p>
				<dl class="facts">
					<div>
						<dt>Year</dt>
						<dd>{year}</dd>
					</div>
					<div>
						<dt>Area</dt>
						<dd>{category}</dd>
					</div>
					{
						badge && (
							<div>
								<dt>Status</dt>
								<dd>{badge}</dd>
							</div>
						)
					}
					<div class="stack-row">
						<dt>Stack</dt>
						<dd class="stack">
							{stack.map((item) => <span class="tag">{item}</span>)}
						</dd>
					</div>
					{
						(links.repo || links.live || links.writeup) && (
							<div class="links-row">
								<dt>Links</dt>
								<dd class="links">
									{links.repo && <a href={links.repo}>Repo ↗</a>}
									{links.live && <a href={links.live}>Live ↗</a>}
									{links.writeup && <a href={links.writeup}>Writeup</a>}
								</dd>
							</div>
						)
					}
				</dl>
			</header>
			<div class="prose">
				<Content />
			</div>
		</article>
	</div>
</Base>

<style>
	.container {
		padding-block: 3rem;
	}
	.back {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--text-dim);
		text-decoration: none;
		display: inline-block;
		margin-bottom: 1.5rem;
	}
	.back:hover {
		color: var(--accent-strong);
		text-decoration: none;
	}
	.summary {
		color: var(--text-dim);
		font-size: var(--text-lg);
		margin-top: 0.5rem;
	}
	.facts {
		display: grid;
		gap: 0.85rem;
		margin: 2rem 0 2.5rem;
		padding: 1.25rem 1.4rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--bg-card);
		font-size: var(--text-sm);
	}
	.facts > div {
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: 1rem;
		align-items: baseline;
	}
	dt {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--text-faint);
	}
	dd {
		margin: 0;
		color: var(--text);
	}
	.stack,
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.5rem;
	}
</style>
