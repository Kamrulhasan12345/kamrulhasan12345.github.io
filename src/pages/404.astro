---
import Button from "@/components/Button.astro";
import Base from "@/layouts/Base.astro";
---

<Base title="404">
	<div class="container container--prose wrap stack">
		<p class="label">Error 0x194</p>
		<h1>Game over</h1>
		<p class="muted">This page doesn't exist. Continue?</p>
		<div class="cluster" style="--cluster-gap: var(--space-4)">
			<Button href="/">Yes</Button>
			<Button href="/blog/" variant="ghost">Read the blog</Button>
		</div>
	</div>
</Base>

<style>
	.wrap {
		--stack-gap: var(--space-6);
		padding-block: var(--space-24);
	}
	h1 {
		font-size: var(--step-4);
		color: var(--color-accent);
	}
</style>
