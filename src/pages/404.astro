---
import Button from "@/components/Button.astro";
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found">
	<div class="container container--prose wrap">
		<p class="label">Error 404</p>
		<h1>Page not found</h1>
		<p class="muted">This address doesn't match any page. It may have moved when the site was rebuilt.</p>
		<div class="cluster">
			<Button href="/">Index</Button>
			<Button href="/projects/" variant="ghost">Projects</Button>
			<Button href="/blog/" variant="ghost">Writing</Button>
		</div>
	</div>
</Base>

<style>
	.wrap {
		display: grid;
		gap: var(--space-4);
		padding-block: var(--space-24);
	}
</style>
