---
import Base from "@/layouts/Base.astro";
---

<Base title="404" description="Page not found.">
	<div class="container box">
		<p class="code">404</p>
		<h1>Page not found</h1>
		<p class="sub">The page you're looking for doesn't exist or has moved.</p>
		<p><a href="/">← Back home</a></p>
	</div>
</Base>

<style>
	.box {
		padding-block: 6rem;
		text-align: center;
	}
	.code {
		font-family: var(--font-mono);
		font-size: 3rem;
		color: var(--accent);
		margin: 0;
	}
	.sub {
		color: var(--text-dim);
		margin-bottom: 1.5rem;
	}
</style>
