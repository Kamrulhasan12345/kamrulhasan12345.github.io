---
import { getPosts } from "@/content.config";
import { about, profile, projects } from "@/data/resume";
import Base from "@/layouts/Base.astro";

const featured = projects.filter((p) => p.featured);
const posts = (await getPosts()).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "2-digit" });
---

<Base>
	<div class="container">
		<p>
			Find me on <a href={profile.github}>GitHub</a>, <a href={profile.linkedin}>LinkedIn</a>,
			<a href={profile.orcid}>ORCID</a>, and <a href={`mailto:${profile.email}`}>email</a>.
		</p>

		<p class="lead">{profile.intro}</p>
		<p>{about.text[0]} <a href="/about/">More about me →</a></p>

		<h2>Now</h2>
		<ul>
			{about.now.map((n) => <li>{n}</li>)}
		</ul>

		<h2>Projects</h2>
		<ul class="entries">
			{
				featured.map((p) => (
					<li>
						{p.link ? <a href={p.link}>{p.name}</a> : <span class="u">{p.name}</span>}: {p.title}. {p.summary}{" "}
						<span class="muted">{p.year}.</span>
					</li>
				))
			}
		</ul>
		<p><a href="/projects/">All {projects.length} projects →</a></p>

		{
			posts.length > 0 && (
				<>
					<h2>Writing</h2>
					<ul class="entries">
						{posts.map((p) => (
							<li class="post">
								<time class="muted" datetime={p.data.publishDate.toISOString()}>
									{fmt(p.data.publishDate)}
								</time>
								<a href={`/blog/${p.id}/`}>{p.data.title}</a>
							</li>
						))}
					</ul>
					<p>
						<a href="/blog/">All posts →</a>
					</p>
				</>
			)
		}

		<h2>Elsewhere on this site</h2>
		<ul class="entries">
			<li><a href="/experience/">Experience</a>: where I've worked and what I did there.</li>
			<li><a href="/research/">Research</a>: publications.</li>
			<li><a href="/contact/">Contact</a>: email and every profile I keep.</li>
		</ul>
	</div>
</Base>

<style>
	.lead {
		margin-top: 1.5rem;
	}
	.u {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	.post {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 1rem;
	}
	@media (max-width: 34rem) {
		.post {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>
