---
import Button from "@/components/Button.astro";
import Card from "@/components/Card.astro";
import Oled from "@/components/Oled.astro";
import PixelIcon from "@/components/PixelIcon.astro";
import type { Glyph } from "@/components/PixelIcon.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHead from "@/components/SectionHead.astro";
import Tag from "@/components/Tag.astro";
import { getPosts } from "@/content.config";
import { about, education, experience, profile, profiles, projects, research, skills } from "@/data/resume";
import Base from "@/layouts/Base.astro";

const featured = projects.filter((p) => p.featured);
const posts = (await getPosts()).slice(0, 4);
const iso = (d: Date) => d.toISOString().slice(0, 10);

// the three focus areas map onto the category colors + glyphs used everywhere else
const focusStyle: Record<string, { glyph: Glyph; color: string }> = {
	"AI Engineering": { glyph: "ml", color: "var(--cat-ml)" },
	"Embedded Systems": { glyph: "embedded", color: "var(--cat-embedded)" },
	Backend: { glyph: "backend", color: "var(--cat-backend)" },
};
---

<Base>
	<div class="container">
		<!-- hero: identity + the one live element -->
		<section class="bento hero" aria-label="Introduction">
			<Card class="span-7 intro">
				<p class="kick label"><span class="dot" aria-hidden="true"></span>{profile.status}</p>
				<h1>{profile.name}</h1>
				<p class="role">{profile.role}</p>
				<p class="lede muted">{profile.intro}</p>
				<div class="cluster cta">
					<Button href="/projects/">Projects</Button>
					<Button href="/resume.pdf" variant="ghost">Résumé (PDF)</Button>
					<Button href="#contact" variant="ghost">Contact</Button>
				</div>
			</Card>
			<Card class="span-5 fig-card">
				<Oled />
			</Card>
		</section>

		<!-- 1 overview -->
		<section class="section" aria-labelledby="overview">
			<SectionHead n={1} title="Overview" id="overview" />
			<div class="bento">
				<Card class="span-7 stack prose-ish">
					{about.text.map((t) => <p>{t}</p>)}
				</Card>
				<Card class="span-5">
					<p class="label card-title">Currently</p>
					<ul class="now" role="list">
						{about.now.map((n) => <li>{n}</li>)}
					</ul>
				</Card>
				{
					about.focus.map((f) => {
						const s = focusStyle[f.title] ?? { glyph: "ml", color: "var(--color-text-strong)" };
						return (
							<Card class="span-4 focus" style={`--c: ${s.color}`}>
								<span class="focus-glyph">
									<PixelIcon glyph={s.glyph} />
								</span>
								<h3>{f.title}</h3>
								<p class="muted small">{f.text}</p>
							</Card>
						);
					})
				}
			</div>
		</section>

		<!-- 2 selected work -->
		<section class="section" aria-labelledby="work">
			<SectionHead n={2} title="Selected work" id="work" more={{ href: "/projects/", label: `all ${projects.length}` }} />
			<ul class="bento work" role="list">
				{featured.map((p) => <ProjectCard project={p} />)}
			</ul>
		</section>

		<!-- 3 experience + education -->
		<section class="section" aria-labelledby="experience">
			<SectionHead n={3} title="Experience" id="experience" />
			<div class="bento">
				<Card class="span-8">
					<ol class="log" role="list">
						{
							experience.map((e, i) => (
								<li>
									<div class="log-head">
										<span class="ref">{i === 0 ? "* HEAD" : `* HEAD~${i}`}</span>
										<h3>
											{e.role} <span class="org">@ {e.org}</span>
										</h3>
										<span class="when mono num">{e.when}</span>
									</div>
									{e.orgNote && <p class="muted small note">{e.orgNote}</p>}
									<ul class="tree" role="list">
										{e.points.map((pt) => (
											<li>{pt}</li>
										))}
									</ul>
									<div class="cluster stack-tags">
										{e.stack.map((s) => (
											<Tag>{s}</Tag>
										))}
									</div>
								</li>
							))
						}
					</ol>
				</Card>
				<Card class="span-4">
					<p class="label card-title">Education</p>
					{
						education.map((ed) => (
							<div class="stack" style="--stack-gap: var(--space-2)">
								<h3>{ed.school}</h3>
								<p class="muted small">{ed.degree}</p>
								<dl class="spec mono">
									<dt>Years</dt>
									<dd class="num">{ed.when}</dd>
									<dt>Place</dt>
									<dd>{ed.location}</dd>
								</dl>
							</div>
						))
					}
				</Card>
			</div>
		</section>

		<!-- 4 publications -->
		<section class="section" aria-labelledby="research">
			<SectionHead n={4} title="Publications" id="research" more={{ href: profile.orcid, label: "orcid" }} />
			<ol class="bento" role="list">
				{
					research.map((r) => (
						<Card as="li" class="span-12 pub">
							<span class="pub-glyph" aria-hidden="true">
								<PixelIcon glyph="research" size={36} />
							</span>
							<div class="stack" style="--stack-gap: var(--space-3)">
								<h3 class="pub-title">{r.link ? <a href={r.link}>{r.title}</a> : r.title}</h3>
								<p class="small muted">
									{r.authors.map((a, i) => (
										<>
											{a === "M. K. Hasan" ? <strong class="me">{a}</strong> : a}
											{i < r.authors.length - 1 && ", "}
										</>
									))}
								</p>
								<p class="muted">{r.detail}</p>
								<dl class="spec mono">
									<dt>Type</dt>
									<dd>{r.kind}</dd>
									<dt>Venue</dt>
									<dd>{r.venue}</dd>
									<dt>Role</dt>
									<dd>{r.role}</dd>
									{r.link && (
										<>
											<dt>DOI</dt>
											<dd>
												<a href={r.link}>{r.link.replace("https://doi.org/", "")} ↗</a>
											</dd>
										</>
									)}
								</dl>
							</div>
						</Card>
					))
				}
			</ol>
		</section>

		<!-- 5 skills -->
		<section class="section" aria-labelledby="skills">
			<SectionHead n={5} title="Skills" id="skills" />
			<Card>
				<dl class="skills">
					{
						skills.map((s) => (
							<div class="skill-row">
								<dt class="label">{s.group}</dt>
								<dd class="cluster">
									{s.items.map((i) => (
										<Tag>{i}</Tag>
									))}
								</dd>
							</div>
						))
					}
				</dl>
			</Card>
		</section>

		<!-- 6 writing -->
		{
			posts.length > 0 && (
				<section class="section" aria-labelledby="writing">
					<SectionHead n={6} title="Writing" id="writing" more={{ href: "/blog/", label: "all posts" }} />
					<Card>
						<ul class="posts" role="list">
							{posts.map((p) => (
								<li>
									<time class="mono muted num" datetime={p.data.publishDate.toISOString()}>
										{iso(p.data.publishDate)}
									</time>
									<a href={`/blog/${p.id}/`}>{p.data.title}</a>
								</li>
							))}
						</ul>
					</Card>
				</section>
			)
		}

		<!-- 7 profiles + contact -->
		<section class="section" aria-labelledby="contact">
			<SectionHead n={posts.length > 0 ? 7 : 6} title="Contact" id="contact" />
			<div class="bento">
				<Card class="span-5 stack contact" style="--stack-gap: var(--space-4)">
					<p class="lede">
						Open to internships, research and anything that runs on small hardware. Email is the fastest way to
						reach me.
					</p>
					<dl class="spec mono">
						<dt>Email</dt>
						<dd><a href={`mailto:${profile.email}`}>{profile.email}</a></dd>
						<dt>Location</dt>
						<dd>{profile.location} (UTC+6)</dd>
						<dt>Résumé</dt>
						<dd><a href="/resume.pdf">resume.pdf ↓</a></dd>
					</dl>
				</Card>
				<Card class="span-7">
					<p class="label card-title">Profiles</p>
					<dl class="spec mono profiles">
						{
							profiles.flatMap((g) =>
								g.links.map((l) => (
									<>
										<dt>{l.name}</dt>
										<dd>
											<a href={l.url}>{l.handle} ↗</a> <span class="muted">· {g.group}</span>
										</dd>
									</>
								)),
							)
						}
					</dl>
				</Card>
			</div>
		</section>
	</div>
</Base>

<style>
	.small {
		font-size: var(--step--1);
	}
	.section {
		margin-top: var(--space-16);
	}

	/* bento: a 12-column grid of flat cards */
	.bento {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: var(--space-3);
		margin: 0;
		padding: 0;
	}
	.bento > :global(*) {
		grid-column: span 12;
	}
	.bento > :global(.span-4) {
		grid-column: span 4;
	}
	.bento > :global(.span-5) {
		grid-column: span 5;
	}
	.bento > :global(.span-7) {
		grid-column: span 7;
	}
	.bento > :global(.span-8) {
		grid-column: span 8;
	}
	.work > :global(li) {
		grid-column: span 6;
	}
	:global(.card-title) {
		margin-bottom: var(--space-4);
	}

	/* hero */
	.hero {
		margin-top: var(--space-6);
	}
	:global(.intro) {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		justify-content: center;
	}
	:global(.fig-card) {
		display: grid;
		align-content: center;
	}
	:global(.contact) .spec {
		margin-top: var(--space-2);
	}
	.profiles {
		grid-template-columns: 8rem 1fr;
	}
	.kick {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-accent);
	}
	.dot {
		width: 6px;
		height: 6px;
		background: var(--cat-embedded);
	}
	.role {
		color: var(--color-text-strong);
	}
	.lede {
		max-width: 52ch;
	}
	.cta {
		--cluster-gap: var(--space-2);
		padding-top: var(--space-2);
	}

	/* overview */
	:global(.prose-ish) {
		--stack-gap: var(--space-4);
	}
	.now {
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-2);
	}
	.now li {
		display: grid;
		grid-template-columns: 1.2em 1fr;
	}
	.now li::before {
		content: "";
		width: 6px;
		height: 6px;
		margin-top: 0.6em;
		background: var(--color-accent);
	}
	:global(.focus) {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.focus-glyph {
		color: var(--c);
	}
	:global(.focus) h3 {
		color: var(--c);
		font-family: var(--font-pixel);
		font-weight: 400;
		letter-spacing: var(--tracking-pixel);
		text-transform: uppercase;
	}

	/* experience: git log */
	.log {
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-8);
	}
	.log-head {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: baseline;
		gap: var(--space-3);
	}
	.ref {
		font-size: var(--step--1);
		color: var(--color-accent);
		white-space: nowrap;
	}
	.org {
		font-weight: 400;
		color: var(--color-text-muted);
	}
	.when {
		color: var(--color-text-faint);
		white-space: nowrap;
	}
	.note {
		margin: var(--space-1) 0 0;
	}
	.tree {
		margin: var(--space-3) 0 0;
		padding: 0;
		color: var(--color-text-muted);
		font-size: var(--step--1);
	}
	.tree li {
		position: relative;
		padding: 0 0 var(--space-2) 2.2em;
	}
	.tree li::before {
		content: "├─";
		position: absolute;
		left: 0;
		color: var(--color-text-faint);
	}
	.tree li:last-child::before {
		content: "└─";
	}
	.stack-tags {
		margin-top: var(--space-2);
		padding-left: 2.2em;
	}

	/* shared spec table (datasheet key/value) */
	.spec {
		display: grid;
		grid-template-columns: 6rem 1fr;
		margin: 0;
		font-size: var(--step--1);
	}
	.spec dt,
	.spec dd {
		margin: 0;
		padding-block: var(--space-1);
		border-bottom: var(--border);
	}
	.spec dt {
		color: var(--color-text-faint);
	}
	.spec dd {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	/* publications */
	:global(.pub) {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-6);
	}
	.pub-glyph {
		color: var(--cat-research);
	}
	.pub-title {
		font-size: var(--step-1);
		line-height: 1.35;
	}
	.pub-title a {
		text-decoration: none;
	}
	.pub-title a:hover {
		text-decoration: underline;
	}
	.me {
		color: var(--color-text-strong);
	}

	/* skills */
	.skills {
		margin: 0;
	}
	.skill-row {
		display: grid;
		grid-template-columns: 13rem 1fr;
		gap: var(--space-4);
		padding-block: var(--space-3);
		border-bottom: var(--border);
	}
	.skill-row:first-child {
		padding-top: 0;
	}
	.skill-row:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}
	.skill-row dt {
		padding-top: 0.35em;
	}
	.skill-row dd {
		margin: 0;
	}

	/* writing */
	.posts {
		margin: 0;
		padding: 0;
	}
	.posts li {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: var(--space-4);
		padding-block: var(--space-3);
		border-bottom: var(--border);
	}
	.posts li:first-child {
		padding-top: 0;
	}
	.posts li:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	@media (max-width: 56rem) {
		.bento > :global(.span-4),
		.bento > :global(.span-5),
		.bento > :global(.span-7),
		.bento > :global(.span-8),
		.work > :global(li) {
			grid-column: span 12;
		}
		.log-head {
			grid-template-columns: auto 1fr;
		}
		.when {
			grid-column: 2;
		}
		.skill-row,
		.posts li {
			grid-template-columns: 1fr;
			gap: var(--space-2);
		}
	}
	@media (max-width: 30rem) {
		:global(.pub) {
			grid-template-columns: 1fr;
		}
	}
</style>
