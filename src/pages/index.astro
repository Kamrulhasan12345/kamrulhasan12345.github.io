---
import { getPosts } from "@/content.config";
import { about, education, experience, profile, projects, research, skills } from "@/data/resume";
import Base from "@/layouts/Base.astro";

const featured = projects.filter((p) => p.featured);
const posts = (await getPosts()).slice(0, 5);
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "2-digit" });
---

<Base>
	<div class="container">
		<p>
			Find me on <a href={profile.github}>GitHub</a>, <a href={profile.linkedin}>LinkedIn</a>,
			<a href={profile.orcid}>ORCID</a>, and <a href={`mailto:${profile.email}`}>email</a>.
		</p>

		<p class="lead">{profile.intro}</p>
		{about.text.map((t) => <p>{t}</p>)}

		<h2>Now</h2>
		<ul>
			{about.now.map((n) => <li>{n}</li>)}
		</ul>

		<h2>Experience</h2>
		<ul class="entries">
			{
				experience.map((e) => (
					<li>
						<strong>{e.role}</strong>, {e.org} <span class="muted">({e.when})</span>
						<ul class="points">
							{e.points.map((pt) => (
								<li>{pt}</li>
							))}
						</ul>
					</li>
				))
			}
			{
				education.map((ed) => (
					<li>
						<strong>{ed.degree}</strong>, {ed.school} <span class="muted">({ed.when})</span>
					</li>
				))
			}
		</ul>

		<h2>Projects</h2>
		<ul class="entries">
			{
				featured.map((p) => (
					<li>
						{p.link ? <a href={p.link}>{p.name}</a> : <span class="u">{p.name}</span>}: {p.title}. {p.summary}{" "}
						<span class="muted">{p.year}.</span>
					</li>
				))
			}
		</ul>
		<p><a href="/projects/">All {projects.length} projects →</a></p>

		<h2>Publications</h2>
		<ul class="entries">
			{
				research.map((r) => (
					<li>
						{r.link ? <a href={r.link}>{r.title}</a> : r.title}.{" "}
						{r.authors.map((a, i) => (
							<>
								{a === "M. K. Hasan" ? <strong>{a}</strong> : a}
								{i < r.authors.length - 1 && ", "}
							</>
						))}
						. <em>{r.venue}</em>.
						<span class="muted">{r.detail}</span>
					</li>
				))
			}
		</ul>

		{
			posts.length > 0 && (
				<>
					<h2>Writing</h2>
					<ul class="entries">
						{posts.map((p) => (
							<li class="post">
								<time class="muted" datetime={p.data.publishDate.toISOString()}>
									{fmt(p.data.publishDate)}
								</time>
								<a href={`/blog/${p.id}/`}>{p.data.title}</a>
							</li>
						))}
					</ul>
				</>
			)
		}

		<h2>Skills</h2>
		<ul class="entries">
			{
				skills.map((s) => (
					<li>
						<strong>{s.group}:</strong> {s.items.join(", ")}.
					</li>
				))
			}
		</ul>

		<h2>Contact</h2>
		<p>
			Open to internships, research and anything that runs on small hardware. Email is fastest:
			<a href={`mailto:${profile.email}`}>{profile.email}</a>. I'm in {profile.location} (UTC+6). My résumé is
			<a href="/resume.pdf">here (PDF)</a>.
		</p>
	</div>
</Base>

<style>
	.lead {
		margin-top: 1.5rem;
	}
	.points {
		margin-top: 0.3em;
		color: var(--text-muted);
	}
	.points li + li {
		margin-top: 0.2em;
	}
	.u {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	.post {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 1rem;
	}
	@media (max-width: 34rem) {
		.post {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>
