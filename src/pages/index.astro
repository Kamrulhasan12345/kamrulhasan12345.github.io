---
import PostPreview from "@/components/PostPreview.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getFeaturedProjects, getPublishedPosts } from "@/data/collections";
import Base from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";

const featured = (await getFeaturedProjects()).slice(0, 4);
const latest = (await getPublishedPosts()).slice(0, 3);
---

<Base>
	<div class="container container--wide">
		<section class="hero">
			<p class="eyebrow">{siteConfig.role} · {siteConfig.location}</p>
			<h1 class="glitch">
				<span class="glitch-base"
					>MOHAMMAD<br />KAMRUL <span class="accent">HASAN</span></span
				>
				<span class="glitch-layer l1" aria-hidden="true">MOHAMMAD<br />KAMRUL HASAN</span>
				<span class="glitch-layer l2" aria-hidden="true">MOHAMMAD<br />KAMRUL HASAN</span>
			</h1>
			<p class="lead">
				CSE undergraduate at <strong>BUET</strong>, writing code since grade 5 and
				drifting steadily down the stack ever since — across systems, security,
				backends, ML, and hardware.
			</p>
			<p class="now">
				<span class="now-label">NOW</span>
				Production WooCommerce plugin at Version3.ai · Bangla NLP dataset at
				Mahzabeen Lab · Ilham hadith platform
			</p>
			<div class="cta">
				<a class="btn btn-primary" href="/projects/">VIEW PROJECTS</a>
				<a class="btn btn-ghost" href="/blog/">READ THE BLOG</a>
			</div>
		</section>

		<section>
			<div class="sec-head">
				<span class="idx">01</span>
				<h2>SELECTED WORK</h2>
				<a class="sec-more" href="/projects/">all projects →</a>
			</div>
			<div class="grid">
				{featured.map((project) => <ProjectCard project={project} />)}
			</div>
		</section>

		{
			latest.length > 0 && (
				<section>
					<div class="sec-head">
						<span class="idx">02</span>
						<h2>WRITING</h2>
						<a class="sec-more" href="/blog/">
							all posts →
						</a>
					</div>
					<div class="posts">
						{latest.map((post) => (
							<PostPreview post={post} />
						))}
					</div>
				</section>
			)
		}
	</div>
</Base>

<style>
	/* ---- hero ---- */
	.hero {
		position: relative;
		padding-block: 4rem 3.5rem;
		max-width: 46rem;
	}
	/* faint pixel grid behind the hero, masked out toward the bottom */
	.hero::before {
		content: "";
		position: absolute;
		inset: 0 -20rem 0 -10rem;
		background-image:
			linear-gradient(var(--line-soft) 1px, transparent 1px),
			linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
		background-size: 48px 48px;
		opacity: 0.5;
		pointer-events: none;
		mask-image: radial-gradient(ellipse 90% 70% at 35% 20%, black 10%, transparent 75%);
		z-index: -1;
	}

	.glitch {
		position: relative;
		display: inline-block;
		font-size: clamp(1.9rem, 1.1rem + 4vw, 3.4rem);
		line-height: 1.2;
		letter-spacing: 0.01em;
		margin: 1rem 0 0;
	}
	.glitch .accent {
		color: var(--accent);
	}
	.glitch-base {
		position: relative;
	}
	.glitch-layer {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		white-space: nowrap;
	}
	.glitch:hover .l1 {
		opacity: 0.85;
		color: var(--glitch-b);
		clip-path: inset(18% 0 52% 0);
		animation: gl1 0.5s steps(2) infinite;
	}
	.glitch:hover .l2 {
		opacity: 0.85;
		color: var(--glitch-a);
		clip-path: inset(58% 0 12% 0);
		animation: gl2 0.6s steps(2) infinite reverse;
	}
	@keyframes gl1 {
		0% {
			transform: translate(-3px, 1px);
		}
		50% {
			transform: translate(3px, -1px);
		}
		100% {
			transform: translate(-2px, 0);
		}
	}
	@keyframes gl2 {
		0% {
			transform: translate(3px, -1px);
		}
		50% {
			transform: translate(-3px, 1px);
		}
		100% {
			transform: translate(2px, 0);
		}
	}

	.lead {
		font-size: var(--text-lg);
		color: var(--text);
		margin-top: 1.5rem;
		max-width: 40rem;
	}
	.lead strong {
		color: var(--heading);
		font-weight: 600;
	}
	.now {
		margin-top: 1.5rem;
		font-size: var(--text-sm);
		color: var(--text-dim);
		line-height: 1.7;
	}
	.now-label {
		font-family: var(--font-pixel);
		font-size: 0.62rem;
		letter-spacing: 0.1em;
		color: var(--amber);
		border: 1px solid var(--amber-muted);
		padding: 0.12rem 0.5rem;
		margin-right: 0.5rem;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2.25rem;
	}

	section {
		margin-bottom: 4.5rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1.1rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.glitch:hover .l1,
		.glitch:hover .l2 {
			animation: none;
		}
	}
</style>
