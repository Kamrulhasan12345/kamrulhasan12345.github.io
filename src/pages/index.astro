---
import PostPreview from "@/components/PostPreview.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getFeaturedProjects, getPublishedPosts } from "@/data/collections";
import Base from "@/layouts/Base.astro";
import { siteConfig } from "@/site.config";

const featured = (await getFeaturedProjects()).slice(0, 4);
const latest = (await getPublishedPosts()).slice(0, 3);

const tickerItems = [
	"SYSTEMS",
	"HARDWARE SECURITY",
	"REVERSE ENGINEERING",
	"BACKEND",
	"POSTGRESQL",
	"RUST",
	"C / ASM",
	"EMBEDDED",
	"ML",
	"PIXEL ART",
	"CTF: PWN / RE",
	"ARCH LINUX",
	"BUET CSE",
];
---

<Base>
	<div class="ticker" aria-hidden="true">
		<div class="ticker-track">
			{
				[0, 1].map(() => (
					<div class="ticker-seq">
						{tickerItems.map((item) => (
							<>
								<span>{item}</span>
								<b>◆</b>
							</>
						))}
					</div>
				))
			}
		</div>
	</div>

	<div class="container container--wide">
		<section class="hero">
			<p class="eyebrow">{siteConfig.role} · {siteConfig.location}</p>
			<h1 class="glitch">
				<span class="glitch-base"
					>MOHAMMAD<br />KAMRUL <span class="accent">HASAN</span></span
				>
				<span class="glitch-layer l1" aria-hidden="true">MOHAMMAD<br />KAMRUL HASAN</span>
				<span class="glitch-layer l2" aria-hidden="true">MOHAMMAD<br />KAMRUL HASAN</span>
			</h1>
			<p class="lead">
				CSE undergraduate at <strong>BUET</strong>, writing code since grade 5 and
				drifting steadily down the stack ever since — across systems, security,
				backends, ML, and hardware.
			</p>
			<p class="now">
				<span class="now-label">Now</span>
				Production WooCommerce plugin at Version3.ai · Bangla NLP dataset at
				Mahzabeen Lab · Ilham hadith platform
			</p>
			<div class="cta">
				<a class="btn btn-primary" href="/projects/">View projects</a>
				<a class="btn btn-ghost" href="/blog/">Read the blog</a>
			</div>
		</section>

		<section>
			<div class="sec-head">
				<h2>Selected work</h2>
				<a class="sec-more" href="/projects/">All projects →</a>
			</div>
			<div class="grid">
				{featured.map((project) => <ProjectCard project={project} />)}
			</div>
		</section>

		{
			latest.length > 0 && (
				<section>
					<div class="sec-head">
						<h2>Writing</h2>
						<a class="sec-more" href="/blog/">
							All posts →
						</a>
					</div>
					<div class="posts">
						{latest.map((post) => (
							<PostPreview post={post} />
						))}
					</div>
				</section>
			)
		}
	</div>
</Base>

<style>
	/* ---- ticker / game strip ---- */
	.ticker {
		border-block: 1px solid var(--line-soft);
		background: var(--bg-raise);
		overflow: hidden;
	}
	.ticker-track {
		display: flex;
		width: max-content;
		animation: marquee 34s linear infinite;
	}
	.ticker:hover .ticker-track {
		animation-play-state: paused;
	}
	.ticker-seq {
		display: flex;
		align-items: center;
	}
	.ticker span {
		font-family: var(--font-pixel);
		font-size: 0.62rem;
		letter-spacing: 0.12em;
		color: var(--text-faint);
		padding-block: 0.6rem;
		white-space: nowrap;
	}
	.ticker b {
		color: var(--accent-muted);
		font-weight: 400;
		padding-inline: 0.9rem;
	}
	@keyframes marquee {
		to {
			transform: translateX(-50%);
		}
	}

	/* ---- hero ---- */
	.hero {
		padding-block: 4rem 3.5rem;
		max-width: 46rem;
	}

	.glitch {
		position: relative;
		display: inline-block;
		font-family: var(--font-pixel);
		font-weight: 400;
		font-size: clamp(1.9rem, 1.1rem + 4vw, 3.4rem);
		line-height: 1.2;
		letter-spacing: 0.01em;
		margin: 1rem 0 0;
		color: var(--heading);
	}
	.glitch .accent {
		color: var(--accent);
	}
	.glitch-base {
		position: relative;
	}
	.glitch-layer {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		white-space: nowrap;
	}
	.glitch:hover .l1 {
		opacity: 0.85;
		color: var(--glitch-b);
		clip-path: inset(18% 0 52% 0);
		animation: gl1 0.5s steps(2) infinite;
	}
	.glitch:hover .l2 {
		opacity: 0.85;
		color: var(--glitch-a);
		clip-path: inset(58% 0 12% 0);
		animation: gl2 0.6s steps(2) infinite reverse;
	}
	@keyframes gl1 {
		0% {
			transform: translate(-3px, 1px);
		}
		50% {
			transform: translate(3px, -1px);
		}
		100% {
			transform: translate(-2px, 0);
		}
	}
	@keyframes gl2 {
		0% {
			transform: translate(3px, -1px);
		}
		50% {
			transform: translate(-3px, 1px);
		}
		100% {
			transform: translate(2px, 0);
		}
	}

	.lead {
		font-size: var(--text-lg);
		color: var(--text);
		margin-top: 1.5rem;
		max-width: 40rem;
	}
	.lead strong {
		color: var(--heading);
		font-weight: 600;
	}
	.now {
		margin-top: 1.5rem;
		font-size: var(--text-sm);
		color: var(--text-dim);
		line-height: 1.7;
	}
	.now-label {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent-strong);
		border: 1px solid var(--accent-muted);
		border-radius: 999px;
		padding: 0.05rem 0.5rem;
		margin-right: 0.5rem;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}
	.btn {
		font-size: var(--text-sm);
		font-weight: 500;
		padding: 0.6rem 1.2rem;
		border-radius: 6px;
		text-decoration: none;
		border: 1px solid transparent;
		transition:
			background 140ms ease,
			border-color 140ms ease,
			color 140ms ease;
	}
	.btn:hover {
		text-decoration: none;
	}
	.btn-primary {
		background: var(--accent);
		color: #10151a;
		font-weight: 600;
	}
	.btn-primary:hover {
		background: var(--accent-strong);
		color: #10151a;
	}
	.btn-ghost {
		border-color: var(--line);
		color: var(--text);
	}
	.btn-ghost:hover {
		border-color: var(--accent-muted);
		color: var(--heading);
	}

	section {
		margin-bottom: 4rem;
	}
	.sec-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid var(--line);
		padding-bottom: 0.75rem;
	}
	.sec-head h2 {
		margin: 0;
		font-size: var(--text-lg);
	}
	.sec-more {
		font-size: var(--text-sm);
		color: var(--text-dim);
		white-space: nowrap;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.ticker-track {
			animation: none;
		}
		.glitch:hover .l1,
		.glitch:hover .l2 {
			animation: none;
		}
	}
</style>
