---
import PixelIcon from "@/components/PixelIcon.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHead from "@/components/SectionHead.astro";
import { categoryStyle } from "@/data/categories";
import { categories, projects } from "@/data/resume";
import Base from "@/layouts/Base.astro";

// newest first, then featured first within a year
const sorted = [...projects].sort(
	(a, b) => b.year.slice(0, 4).localeCompare(a.year.slice(0, 4)) || Number(!!b.featured) - Number(!!a.featured),
);
const counts = Object.fromEntries(categories.map((c) => [c, projects.filter((p) => p.categories.includes(c)).length]));
---

<Base title="Projects" description={`All ${projects.length} projects: AI/ML, embedded systems, backends and apps.`}>
	<div class="container">
		<header class="page-head">
			<h1>Projects</h1>
			<p class="muted lead">
				Everything I've built, from on-device AI and embedded work to backends and apps. Search by name or
				technology, or filter by area.
			</p>
		</header>

		<SectionHead n={1} title={`Index · ${projects.length} entries`} />
		<div class="controls">
			<label class="search">
				<span class="sr-only">Search projects</span>
				<span class="mono muted" aria-hidden="true">search</span>
				<input id="q" type="search" placeholder="llama.cpp, ESP32, PostgreSQL…" autocomplete="off" />
			</label>
			<div class="filters" role="group" aria-label="Filter by area">
				<button type="button" class="chip" data-cat="" aria-pressed="true">All <span class="num">{projects.length}</span></button>
				{
					categories.map((c) => (
						<button type="button" class="chip" data-cat={c} aria-pressed="false" style={`--c: ${categoryStyle[c].color}`}>
							<span class="glyph">
								<PixelIcon glyph={categoryStyle[c].glyph} size={12} />
							</span>
							{c} <span class="num">{counts[c]}</span>
						</button>
					))
				}
			</div>
			<p class="count mono muted num" id="count" aria-live="polite">Showing {projects.length} projects</p>
		</div>

		<ul class="grid" role="list" id="grid">
			{sorted.map((p) => <ProjectCard project={p} detailed />)}
		</ul>
		<p class="empty muted" id="empty" hidden>No projects match. Try a different word or clear the filter.</p>
	</div>
</Base>

<script>
	const q = document.querySelector<HTMLInputElement>("#q")!;
	const chips = [...document.querySelectorAll<HTMLButtonElement>(".chip")];
	const cards = [...document.querySelectorAll<HTMLElement>("[data-project]")];
	const count = document.querySelector("#count")!;
	const empty = document.querySelector<HTMLElement>("#empty")!;

	const params = new URLSearchParams(location.search);
	let cat = params.get("area") ?? "";
	q.value = params.get("q") ?? "";

	function apply() {
		const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
		let shown = 0;
		for (const card of cards) {
			const inCat = !cat || card.dataset.categories!.split("|").includes(cat);
			const hit = terms.every((t) => card.dataset.search!.includes(t));
			const visible = inCat && hit;
			// hide the <li> wrapper, not just the inner card
			card.closest("li")!.hidden = !visible;
			if (visible) shown++;
		}
		for (const c of chips) c.setAttribute("aria-pressed", String(c.dataset.cat === cat));
		count.textContent = `Showing ${shown} of ${cards.length} projects`;
		empty.hidden = shown > 0;

		// keep the URL shareable: /projects/?area=Backend&q=rust
		const next = new URLSearchParams();
		if (cat) next.set("area", cat);
		if (q.value.trim()) next.set("q", q.value.trim());
		history.replaceState(null, "", next.size ? `?${next}` : location.pathname);
	}

	q.addEventListener("input", apply);
	for (const c of chips)
		c.addEventListener("click", () => {
			cat = c.dataset.cat ?? "";
			apply();
		});
	apply();
</script>

<style>
	.page-head {
		display: grid;
		gap: var(--space-4);
		padding-block: var(--space-8) var(--space-12);
	}
	.lead {
		max-width: 56ch;
	}
	.controls {
		display: grid;
		gap: var(--space-3);
		margin-bottom: var(--space-6);
	}
	.search {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		background: var(--color-bg-sunken);
		border: var(--border-strong);
	}
	.search:focus-within {
		border-color: var(--color-text-strong);
	}
	input {
		flex: 1;
		min-width: 0;
		background: none;
		border: 0;
		outline: 0;
		color: var(--color-text-strong);
		font: var(--step-0) var(--font-mono);
	}
	input::placeholder {
		color: var(--color-text-faint);
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}
	.chip {
		--c: var(--color-text-strong);
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-3);
		font: var(--step--1) var(--font-mono);
		color: var(--color-text-muted);
		background: none;
		border: var(--border-strong);
		cursor: pointer;
		transition:
			color var(--dur-fast),
			border-color var(--dur-fast);
	}
	.chip .glyph {
		color: var(--c);
	}
	.chip span.num {
		color: var(--color-text-faint);
	}
	.chip:hover {
		color: var(--color-text-strong);
		border-color: var(--c);
	}
	.chip[aria-pressed="true"] {
		color: var(--color-bg);
		background: var(--c);
		border-color: var(--c);
	}
	.chip[aria-pressed="true"] .glyph,
	.chip[aria-pressed="true"] span.num {
		color: var(--color-bg);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
		gap: var(--space-3);
		margin: 0;
		padding: 0;
	}
	.grid > :global(li[hidden]) {
		display: none;
	}
	.empty {
		padding-block: var(--space-12);
		text-align: center;
	}
</style>
