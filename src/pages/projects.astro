---
import { categories, projects } from "@/data/resume";
import Base from "@/layouts/Base.astro";

// newest first, then featured first within a year
const sorted = [...projects].sort(
	(a, b) => b.year.slice(0, 4).localeCompare(a.year.slice(0, 4)) || Number(!!b.featured) - Number(!!a.featured),
);
// each project listed once, under its first area
const groups = categories.map((c) => ({ area: c, items: sorted.filter((p) => p.categories[0] === c) })).filter((g) => g.items.length);
---

<Base title="Projects" description={`All ${projects.length} projects: AI/ML, embedded systems, backends and apps.`}>
	<div class="container">
		<h1>Projects</h1>
		<p class="muted">Everything I've built, grouped by area, newest first.</p>
		{
			groups.map((g) => (
				<>
					<h2>{g.area}</h2>
					<ul class="entries">
						{g.items.map((p) => (
							<li>
								{p.link ? <a href={p.link}>{p.name}</a> : <span class="u">{p.name}</span>}: {p.title}. {p.summary}
								{p.context && <> {p.context}.</>} <span class="muted">Built with {p.stack.join(", ")}. {p.year}.</span>
							</li>
						))}
					</ul>
				</>
			))
		}
	</div>
</Base>

<style>
	h1 {
		margin-bottom: 0.5rem;
	}
	.u {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
</style>
