---
import { projects } from "@/data/resume";
import Base from "@/layouts/Base.astro";

// newest first
const sorted = [...projects].sort((a, b) => b.year.slice(0, 4).localeCompare(a.year.slice(0, 4)));
const featured = sorted.filter((p) => p.featured);
const rest = sorted.filter((p) => !p.featured);
---

<Base title="Projects" description={`${projects.length} projects in on-device AI, ML systems and backends, with the numbers behind them.`}>
	<div class="container">
		<h1>Projects</h1>
		<p class="muted">The four I'd show first, then everything else, newest first.</p>

		<h2>Featured</h2>
		<ul class="entries featured">
			{
				featured.map((p) => (
					<li>
						<h3>
							{p.link ? <a href={p.link}>{p.name}</a> : p.name}: {p.title}
						</h3>
						<p class="muted small">
							{p.year}
							{p.context && <> · {p.context}</>}
						</p>
						<ul>
							<li>{p.summary}</li>
							{p.points.map((pt) => (
								<li>{pt}</li>
							))}
						</ul>
						<p class="muted small">Built with {p.stack.join(", ")}.</p>
					</li>
				))
			}
		</ul>

		<h2>More</h2>
		<ul class="entries">
			{
				rest.map((p) => (
					<li>
						<strong>{p.link ? <a href={p.link}>{p.name}</a> : p.name}</strong>
						{p.status && <span class="status">{p.status.toLowerCase()}</span>}: {p.title}. {p.summary}{" "}
						<span class="muted">
							{p.stack.join(", ")}. {p.year}.
						</span>
					</li>
				))
			}
		</ul>
	</div>
</Base>

<style>
	h1 {
		margin-bottom: 0.5rem;
	}
	.featured > li + li {
		margin-top: 2rem;
	}
	h3 a {
		color: inherit;
	}
	.featured ul {
		margin-block: 0.4em;
	}
	.status {
		margin-left: 0.4em;
		padding: 0 0.35em;
		font-size: 0.75rem;
		border: 1px solid var(--text-muted);
		color: var(--text-muted);
		white-space: nowrap;
	}
</style>
