---
import { experience, profile } from "@/data/resume";
import Base from "@/layouts/Base.astro";
---

<Base title="Experience" description={`Work experience of ${profile.name}.`}>
	<div class="container">
		<h1>Experience</h1>
		<p class="muted">Where I've worked, newest first. The full record is in my <a href="/resume.pdf">résumé (PDF)</a>.</p>
		{
			experience.map((e) => (
				<>
					<h2>{e.org}</h2>
					<p>
						<strong>{e.role}</strong> <span class="muted">· {e.when}</span>
					</p>
					{e.orgNote && <p class="muted">{e.orgNote}</p>}
					<ul class="points">
						{e.points.map((pt) => (
							<li>{pt}</li>
						))}
					</ul>
					<p class="muted small">Stack: {e.stack.join(", ")}.</p>
				</>
			))
		}
	</div>
</Base>

<style>
	h1 {
		margin-bottom: 0.5rem;
	}
	.points {
		margin-bottom: 0.6em;
	}
	.points li + li {
		margin-top: 0.3em;
	}
</style>
