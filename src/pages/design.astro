---
// Living style guide: renders the real tokens and components, so it can't drift from the site.
import Button from "@/components/Button.astro";
import PixelCard from "@/components/PixelCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/resume";
import SectionHead from "@/components/SectionHead.astro";
import Tag from "@/components/Tag.astro";
import Base from "@/layouts/Base.astro";

const colors = [
	["--color-bg", "page background"],
	["--color-bg-sunken", "ticker, footer, code"],
	["--color-surface", "cards"],
	["--color-surface-raised", "card hover"],
	["--color-border", "hairlines"],
	["--color-text", "body text"],
	["--color-text-muted", "secondary text"],
	["--color-text-faint", "labels only"],
	["--color-accent", "phosphor: links, primary"],
	["--color-accent-dim", "accent borders"],
	["--color-accent-shadow", "pixel shadows"],
	["--color-highlight", "amber: scores, venues"],
];

const type = [
	["--step-4", "font-pixel", "Display"],
	["--step-3", "font-pixel", "Heading 1"],
	["--step-2", "font-pixel", "Heading 2"],
	["--step-1", "font-sans", "Heading 3 / lead"],
	["--step-0", "font-sans", "Body text that people actually read."],
	["--step--1", "font-mono", "meta · dates · nav"],
	["--step--2", "font-pixel", "LABEL"],
];

const space = ["--space-1", "--space-2", "--space-3", "--space-4", "--space-6", "--space-8", "--space-12", "--space-16", "--space-24"];
---

<Base title="Design system" description="Tokens and components behind this site.">
	<div class="container">
		<header class="page-head stack">
			<p class="label">/design</p>
			<h1>Design system</h1>
			<p class="muted lead">
				"Phosphor terminal": a CRT-green accent, amber for scores, pixel type for headings and readable sans for
				prose. Everything snaps to a 4px pixel. Tokens live in <code>src/styles/tokens.css</code>; components
				read semantic tokens only.
			</p>
		</header>

		<section class="block">
			<SectionHead index={1} title="Color" />
			<ul class="swatches" role="list">
				{
					colors.map(([token, use]) => (
						<li>
							<span class="chip" style={`background: var(${token})`} />
							<code>{token}</code>
							<span class="muted small">{use}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="block">
			<SectionHead index={2} title="Type" />
			<ul class="types" role="list">
				{
					type.map(([step, font, sample]) => (
						<li>
							<code class="small muted">
								{step} / {font}
							</code>
							<span style={`font-size: var(${step}); font-family: var(--${font}); line-height: 1.2`}>{sample}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="block">
			<SectionHead index={3} title="Space" />
			<ul class="spaces" role="list">
				{
					space.map((s) => (
						<li>
							<code class="small muted">{s}</code>
							<span class="bar" style={`width: var(${s})`} />
						</li>
					))
				}
			</ul>
		</section>

		<section class="block">
			<SectionHead index={4} title="Components" more={{ href: "#", label: "src/components" }} />
			<div class="demo-grid">
				<PixelCard>
					<div class="stack">
						<p class="label">Button</p>
						<div class="cluster" style="--cluster-gap: var(--space-4)">
							<Button href="#">Primary</Button>
							<Button href="#" variant="ghost">Ghost</Button>
						</div>
					</div>
				</PixelCard>
				<PixelCard>
					<div class="stack">
						<p class="label">Tag</p>
						<div class="cluster">
							<Tag>llama.cpp</Tag>
							<Tag>ESP32-S3</Tag>
							<Tag tone="highlight">UbiComp 2026</Tag>
						</div>
					</div>
				</PixelCard>
				<PixelCard interactive>
					<div class="stack">
						<p class="label">PixelCard (interactive)</p>
						<p class="muted">Notched 1px corners via clip-path. Hover to see the accent ring.</p>
					</div>
				</PixelCard>
			</div>
			<p class="label demo-label">ProjectCard (built on PixelCard + Tag)</p>
			<ul class="demo-grid">
				<ProjectCard project={projects[0]} />
			</ul>
		</section>

		<section class="block">
			<SectionHead index={5} title="Rules" />
			<ol class="rules">
				<li>Pixel font for headings and labels only. Never for paragraphs.</li>
				<li>One accent per element. Green means interactive; amber means a number or a venue.</li>
				<li>Shadows are hard and offset by whole pixels. No blur, except the accent glow on the name.</li>
				<li>Motion uses <code>steps()</code>, and everything stops under <code>prefers-reduced-motion</code>.</li>
				<li>Faint text is for labels; anything people must read uses muted or stronger (≥ 4.5:1).</li>
			</ol>
		</section>
	</div>
</Base>

<style>
	.page-head {
		padding-block: var(--space-12);
	}
	.lead {
		max-width: 44rem;
	}
	.block {
		margin-top: var(--space-16);
	}
	ul,
	ol {
		margin: 0;
		padding: 0;
	}
	.small {
		font-size: var(--step--2);
	}
	.swatches {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
		gap: var(--space-6);
	}
	.swatches li {
		display: grid;
		gap: var(--space-1);
	}
	.chip {
		height: var(--space-16);
		border: var(--border);
		box-shadow: var(--shadow-px-1);
		margin-bottom: var(--space-2);
	}
	.types li,
	.spaces li {
		display: grid;
		grid-template-columns: 14rem 1fr;
		align-items: center;
		gap: var(--space-6);
		padding-block: var(--space-3);
		border-bottom: 1px dashed var(--color-border);
	}
	.bar {
		height: var(--space-3);
		background: var(--color-accent);
	}
	.demo-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-6);
	}
	.demo-label {
		margin: var(--space-8) 0 var(--space-4);
	}
	.rules {
		padding-left: var(--space-6);
		color: var(--color-text-muted);
	}
	.rules li + li {
		margin-top: var(--space-2);
	}
	.rules li::marker {
		font-family: var(--font-pixel);
		color: var(--color-accent);
	}
	@media (max-width: 52rem) {
		.demo-grid {
			grid-template-columns: 1fr;
		}
		.types li,
		.spaces li {
			grid-template-columns: 1fr;
			gap: var(--space-2);
		}
	}
</style>
