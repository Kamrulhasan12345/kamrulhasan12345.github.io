---
// Living style guide: renders the real tokens and components, so it can't drift from the site.
import Button from "@/components/Button.astro";
import Card from "@/components/Card.astro";
import PixelIcon from "@/components/PixelIcon.astro";
import type { Glyph } from "@/components/PixelIcon.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHead from "@/components/SectionHead.astro";
import Tag from "@/components/Tag.astro";
import { projects } from "@/data/resume";
import Base from "@/layouts/Base.astro";

const neutrals = [
	["--color-bg", "page background"],
	["--color-bg-sunken", "inputs, code, the OLED bezel"],
	["--color-surface", "cards"],
	["--color-surface-raised", "card hover"],
	["--color-border", "hairlines"],
	["--color-border-strong", "tabs, buttons"],
	["--color-text-strong", "headings, rules, active tab"],
	["--color-text", "body text"],
	["--color-text-muted", "secondary text"],
	["--color-text-faint", "labels only"],
];
const cats: [string, Glyph, string][] = [
	["--cat-ml", "ml", "AI / ML · also the page accent"],
	["--cat-embedded", "embedded", "Embedded & systems · the OLED"],
	["--cat-backend", "backend", "Backend"],
	["--cat-apps", "apps", "Apps"],
	["--cat-research", "research", "Publications"],
];
const type = [
	["--step-3", "font-pixel", "Name / page title", "uppercase"],
	["--step-2", "font-mono", "Post title", "none"],
	["--step-1", "font-mono", "Card title and lead", "none"],
	["--step-0", "font-mono", "Body text that people actually read.", "none"],
	["--step--1", "font-mono", "meta · dates · spec tables", "none"],
	["--step--2", "font-mono", "Micro-caps label", "uppercase"],
];
const space = ["--space-1", "--space-2", "--space-3", "--space-4", "--space-6", "--space-8", "--space-12", "--space-16", "--space-24"];
---

<Base title="Design system" description="Tokens and components behind this site.">
	<div class="container">
		<header class="page-head">
			<h1>Design system</h1>
			<p class="muted lead">
				"Datasheet": the site reads like a component datasheet for a person. Ink-dark surface, flat hairline
				cards on a 12-column grid, Silkscreen for the name and titles, Geist Mono for everything else, and one
				pastel per kind of work. Tokens live in <code>src/styles/tokens.css</code>; components read semantic
				tokens only. Chosen in the Identity Picker (see <code>docs/design-research</code>).
			</p>
		</header>

		<section class="block">
			<SectionHead n={1} title="Neutrals" />
			<ul class="swatches" role="list">
				{
					neutrals.map(([token, use]) => (
						<li>
							<span class="chip" style={`background: var(${token})`} />
							<code>{token}</code>
							<span class="muted small">{use}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="block">
			<SectionHead n={2} title="Category colors + glyphs" />
			<ul class="swatches" role="list">
				{
					cats.map(([token, glyph, use]) => (
						<li style={`--c: var(${token})`}>
							<span class="chip cat">
								<PixelIcon glyph={glyph} size={36} />
							</span>
							<code>{token}</code>
							<span class="muted small">{use}</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="block">
			<SectionHead n={3} title="Type" />
			<ul class="types" role="list">
				{
					type.map(([step, font, sample, tt]) => (
						<li>
							<code class="small muted">
								{step} / {font}
							</code>
							<span style={`font-size: var(${step}); font-family: var(--${font}); line-height: 1.2; text-transform: ${tt}`}>
								{sample}
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="block">
			<SectionHead n={4} title="Space · 4px grid" />
			<ul class="spaces" role="list">
				{
					space.map((s) => (
						<li>
							<code class="small muted">{s}</code>
							<span class="bar" style={`width: var(${s})`} />
						</li>
					))
				}
			</ul>
		</section>

		<section class="block">
			<SectionHead n={5} title="Components" more={{ href: "#", label: "src/components" }} />
			<div class="demo-grid">
				<Card>
					<p class="label demo-title">Button</p>
					<div class="cluster">
						<Button href="#">Primary</Button>
						<Button href="#" variant="ghost">Ghost</Button>
					</div>
				</Card>
				<Card>
					<p class="label demo-title">Tag</p>
					<div class="cluster">
						<Tag>llama.cpp</Tag>
						<Tag>ESP32-S3</Tag>
						<Tag color="var(--cat-ml)">ML</Tag>
						<Tag color="var(--cat-embedded)">Embedded</Tag>
					</div>
				</Card>
				<Card interactive>
					<p class="label demo-title">Card (interactive)</p>
					<p class="muted">Flat and square with a hairline border. Hover raises the surface one step.</p>
				</Card>
				<Card>
					<p class="label demo-title">Section head</p>
					<SectionHead n={7} title="Example section" more={{ href: "#", label: "more" }} />
				</Card>
			</div>
			<p class="label demo-label">ProjectCard (Card + PixelIcon + Tag + spec table)</p>
			<ul class="demo-grid" role="list">
				<ProjectCard project={projects[0]} />
			</ul>
		</section>

		<section class="block">
			<SectionHead n={6} title="Rules" />
			<ol class="rules">
				<li>Silkscreen for the name, page titles and project names only. Everything people read is Geist Mono.</li>
				<li>Color means the kind of work. AI/ML violet, embedded green, backend amber, apps cyan, research coral. Nothing else is colored.</li>
				<li>Flat: hairline borders, square corners, no shadows, glows or textures.</li>
				<li>Sections are numbered by their real position, in micro caps on a heavy rule, like datasheet chapters.</li>
				<li>Facts go in spec tables (key, value), taken from <code>src/data/resume.ts</code>. Never invent a number.</li>
				<li>One live element per page: the OLED. It pauses off-screen and is a still frame under <code>prefers-reduced-motion</code>.</li>
				<li>Faint text is for labels; anything people must read uses muted or stronger (≥ 4.5:1 on cards).</li>
			</ol>
		</section>
	</div>
</Base>

<style>
	.page-head {
		display: grid;
		gap: var(--space-4);
		padding-block: var(--space-8) var(--space-12);
	}
	.lead {
		max-width: 60ch;
	}
	.block {
		margin-top: var(--space-16);
	}
	ul,
	ol {
		margin: 0;
		padding: 0;
	}
	.small {
		font-size: var(--step--2);
	}
	.swatches {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
		gap: var(--space-6) var(--space-4);
	}
	.swatches li {
		display: grid;
		gap: var(--space-1);
	}
	.chip {
		height: var(--space-16);
		border: var(--border);
		margin-bottom: var(--space-2);
	}
	.chip.cat {
		display: grid;
		place-items: center;
		color: var(--c);
		background: var(--color-surface);
		border-color: color-mix(in oklab, var(--c) 45%, transparent);
	}
	.types li,
	.spaces li {
		display: grid;
		grid-template-columns: 14rem 1fr;
		align-items: center;
		gap: var(--space-6);
		padding-block: var(--space-3);
		border-bottom: var(--border);
	}
	.bar {
		height: var(--space-3);
		background: var(--color-text-strong);
	}
	.demo-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-3);
	}
	.demo-title {
		margin-bottom: var(--space-4);
	}
	.demo-label {
		margin: var(--space-8) 0 var(--space-4);
	}
	.rules {
		padding-left: var(--space-6);
		color: var(--color-text-muted);
	}
	.rules li + li {
		margin-top: var(--space-2);
	}
	.rules li::marker {
		color: var(--color-text-faint);
	}
	@media (max-width: 52rem) {
		.demo-grid {
			grid-template-columns: 1fr;
		}
		.types li,
		.spaces li {
			grid-template-columns: 1fr;
			gap: var(--space-2);
		}
	}
</style>
