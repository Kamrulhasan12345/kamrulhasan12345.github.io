---
import { profile, research } from "@/data/resume";
import Base from "@/layouts/Base.astro";
---

<Base title="Research" description={`Publications and research by ${profile.name}.`}>
	<div class="container">
		<h1>Research</h1>
		<p class="muted">Publications, newest first. Also on <a href={profile.orcid}>ORCID</a>.</p>
		{
			research.map((r) => (
				<>
					<h2>{r.link ? <a href={r.link}>{r.title}</a> : r.title}</h2>
					<p>
						{r.authors.map((a, i) => (
							<>
								{a === "M. K. Hasan" ? <strong>{a}</strong> : a}
								{i < r.authors.length - 1 && ", "}
							</>
						))}
					</p>
					<p>
						<em>{r.venue}</em>. {r.kind}. My role: {r.role.toLowerCase()}.
					</p>
					<p class="muted">{r.detail}</p>
					{r.link && (
						<p class="small">
							DOI: <a href={r.link}>{r.link.replace("https://doi.org/", "")}</a>
						</p>
					)}
				</>
			))
		}
	</div>
</Base>

<style>
	h1 {
		margin-bottom: 0.5rem;
	}
	h2 {
		font-size: 1.15rem;
		line-height: 1.45;
	}
	h2 a {
		color: inherit;
	}
</style>
