---
import { profile, profiles } from "@/data/resume";
import Base from "@/layouts/Base.astro";
---

<Base title="Contact" description={`How to reach ${profile.name}.`}>
	<div class="container">
		<h1>Contact</h1>
		<p>
			I'm open to internships, research and anything that runs on small hardware. Email is the fastest way to reach
			me: <a href={`mailto:${profile.email}`}>{profile.email}</a>.
		</p>
		<p class="muted">I'm in {profile.location} (UTC+6). My résumé is <a href="/resume.pdf">here (PDF)</a>.</p>

		{
			profiles.map((g) => (
				<>
					<h2>{g.group}</h2>
					<ul class="entries">
						{g.links.map((l) => (
							<li>
								<a href={l.url}>{l.name}</a>: <span class="muted">{l.handle}</span>
							</li>
						))}
					</ul>
				</>
			))
		}
	</div>
</Base>

<style>
	h1 {
		margin-bottom: 0.5rem;
	}
</style>
