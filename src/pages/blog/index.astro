---
import SectionHead from "@/components/SectionHead.astro";
import Tag from "@/components/Tag.astro";
import { getPosts } from "@/content.config";
import Base from "@/layouts/Base.astro";

const posts = await getPosts();
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="Writing" description="Notes on systems, compilers, and running things on small hardware.">
	<div class="container container--prose">
		<header class="page-head">
			<h1>Writing</h1>
			<p class="muted">Notes on systems, compilers, and running things on small hardware.</p>
		</header>
		<SectionHead n={1} title={`Posts · ${posts.length}`} more={{ href: "/rss.xml", label: "rss" }} />
		<ul class="posts" role="list">
			{
				posts.map((p) => (
					<li>
						<time class="mono muted num" datetime={p.data.publishDate.toISOString()}>
							{iso(p.data.publishDate)}
						</time>
						<div class="body">
							<h2>
								<a href={`/blog/${p.id}/`}>{p.data.title}</a>
							</h2>
							<p class="muted">{p.data.description}</p>
							<div class="cluster">
								{p.data.tags.map((t) => (
									<Tag>{t}</Tag>
								))}
							</div>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</Base>

<style>
	.page-head {
		display: grid;
		gap: var(--space-4);
		padding-block: var(--space-8) var(--space-12);
	}
	.posts {
		margin: 0;
		padding: 0;
	}
	.posts li {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: var(--space-4);
		padding-block: var(--space-6);
		border-bottom: var(--border);
	}
	.posts li:first-child {
		padding-top: 0;
	}
	.body {
		display: grid;
		gap: var(--space-2);
	}
	h2 a {
		text-decoration: none;
	}
	h2 a:hover {
		text-decoration: underline;
	}
	@media (max-width: 36rem) {
		.posts li {
			grid-template-columns: 1fr;
			gap: var(--space-2);
		}
	}
</style>
