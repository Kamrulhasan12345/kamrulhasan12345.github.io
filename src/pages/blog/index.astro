---
import { getPosts } from "@/content.config";
import Base from "@/layouts/Base.astro";

const posts = await getPosts();
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "2-digit" });
---

<Base title="Writing" description="Notes on systems, compilers, and running things on small hardware.">
	<div class="container">
		<h1>Writing</h1>
		<p class="muted">Notes on systems, compilers, and running things on small hardware.{posts.length > 0 && <> <a href="/rss.xml">RSS</a>.</>}</p>
		{posts.length === 0 && <p>Nothing published yet. Meanwhile, the <a href="/projects/">projects</a> have the details.</p>}
		<ul class="entries">
			{
				posts.map((p) => (
					<li>
						<time class="muted" datetime={p.data.publishDate.toISOString()}>
							{fmt(p.data.publishDate)}
						</time>
						<div>
							<a href={`/blog/${p.id}/`}>{p.data.title}</a>
							<p class="muted small">{p.data.description}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</Base>

<style>
	h1 {
		margin-bottom: 0.5rem;
	}
	.entries {
		margin-top: 2rem;
	}
	li {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 1rem;
	}
	li + li {
		margin-top: 1.2em !important;
	}
	@media (max-width: 34rem) {
		li {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>
