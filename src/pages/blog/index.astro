---
import SectionHead from "@/components/SectionHead.astro";
import Tag from "@/components/Tag.astro";
import { getPosts } from "@/content.config";
import Base from "@/layouts/Base.astro";

const posts = await getPosts();
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "2-digit" });
---

<Base title="Writing" description="Notes on systems, compilers, and running things on small hardware.">
	<div class="container container--prose">
		<header class="page-head stack">
			<p class="label">/blog</p>
			<h1>Writing</h1>
			<p class="muted">Notes on systems, compilers, and running things on small hardware.</p>
		</header>
		<SectionHead index={posts.length} title="Posts" more={{ href: "/rss.xml", label: "rss" }} />
		<ul class="posts" role="list">
			{
				posts.map((p) => (
					<li class="stack" style="--stack-gap: var(--space-2)">
						<time class="mono muted" datetime={p.data.publishDate.toISOString()}>
							{fmt(p.data.publishDate)}
						</time>
						<h2 class="post-title">
							<a href={`/blog/${p.id}/`}>{p.data.title}</a>
						</h2>
						<p class="muted">{p.data.description}</p>
						<div class="cluster">
							{p.data.tags.map((t) => (
								<Tag>#{t}</Tag>
							))}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</Base>

<style>
	.page-head {
		padding-block: var(--space-12);
	}
	.posts {
		margin: 0;
		padding: 0;
	}
	.posts li {
		padding-block: var(--space-6);
		border-bottom: 1px dashed var(--color-border);
	}
	.post-title {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: var(--step-1);
		text-transform: none;
		letter-spacing: 0;
	}
	.post-title a {
		color: var(--color-text-strong);
	}
	.post-title a:hover {
		color: var(--color-accent);
	}
</style>
