---
import PostPreview from "@/components/PostPreview.astro";
import { getAllTags, getPublishedPosts } from "@/data/collections";
import Base from "@/layouts/Base.astro";

const posts = await getPublishedPosts();
const tags = await getAllTags();
---

<Base title="Blog" description="Writing on systems programming, hardware security, compilers, and things learned the hard way.">
	<div class="container">
		<header class="page-head">
			<h1>Blog</h1>
			<p class="sub">
				Systems programming, hardware security, compilers, and things learned the
				hard way.
			</p>
		</header>
		{
			tags.length > 0 && (
				<p class="tags">
					{tags.map(({ tag, count }) => (
						<a class="tag" href={`/tags/${tag}/`}>
							{tag} · {count}
						</a>
					))}
				</p>
			)
		}
		<div class="posts">
			{posts.map((post) => <PostPreview post={post} />)}
			{posts.length === 0 && <p class="empty">No posts published yet.</p>}
		</div>
	</div>
</Base>

<style>
	.container {
		padding-block: 3rem;
	}
	.page-head {
		margin-bottom: 1.5rem;
	}
	.sub {
		color: var(--text-dim);
		margin-top: 0.5rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1rem;
	}
	.empty {
		color: var(--text-dim);
		padding: 2rem 0;
	}
</style>
